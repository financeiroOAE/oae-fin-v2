generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  displayName     String?
  passwordHash    String
  role            String   @default("USER")
  menuPermissions String   @default("[]")
  isActive        Boolean  @default(true)
  mustChangePass  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SyncHistory {
  id           String   @id @default(cuid())
  triggeredBy  String
  status       String
  recordsCount Int?
  details      String?
  errorMessage String?
  createdAt    DateTime @default(now())
}

model FinancialSnapshot {
  id        String   @id
  username  String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BillingForecast {
  id           String   @id @default(cuid())
  sourceKey    String?  @unique
  project      String
  document     String?
  forecastDate DateTime
  amount       Float
  isActive     Boolean  @default(true)
  createdBy    String
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([forecastDate])
  @@index([project])
}
