generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  displayName     String?
  passwordHash    String
  role            String   @default("USER")
  menuPermissions String   @default("[]")
  isActive        Boolean  @default(true)
  mustChangePass  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SyncHistory {
  id           String   @id @default(cuid())
  triggeredBy  String
  status       String
  recordsCount Int?
  details      String?
  errorMessage String?
  createdAt    DateTime @default(now())
}

model FinancialSnapshot {
  id        String   @id
  username  String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BillingForecast {
  id           String   @id @default(cuid())
  sourceKey    String?  @unique
  project      String
  document     String?
  forecastDate DateTime
  amount       Float
  isActive     Boolean  @default(true)
  createdBy    String
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([forecastDate])
  @@index([project])
}

model LoanContract {
  id              String   @id @default(cuid())
  cpDocument      String?  @unique
  sourceKey       String?
  holder          String?
  kind            String   @default("EMPRESTIMO")
  sourceNote      String?  @db.Text
  reviewNotes     String?  @db.Text
  scheduleBasis   String   @default("OFICIAL")
  bank            String
  contractNumber  String?
  modality        String?
  amount          Decimal  @db.Decimal(14, 2)
  startDate       DateTime?
  installmentCount Int
  status          String   @default("ATIVO")
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  installments    LoanInstallment[]
  documents       LoanDocument[]
}

model LoanInstallment {
  id          String   @id @default(cuid())
  contractId  String
  number      Int
  dueDate     DateTime
  principal   Decimal  @db.Decimal(14, 2)
  interest    Decimal  @db.Decimal(14, 2)
  other       Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  contract    LoanContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@unique([contractId, number])
  @@index([dueDate])
}

model LoanDocument {
  id          String   @id @default(cuid())
  contractId  String
  filename    String
  mimeType    String
  content     Bytes
  createdAt   DateTime @default(now())
  contract    LoanContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model TeamPerson {
  id             String   @id @default(cuid())
  name           String
  department     String
  relationship   String   @default("PJ")
  modality       String?
  jobTitle       String?
  company        String?
  email          String?
  phone          String?
  cpBeneficiary  String?
  status         String   @default("ATIVO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contracts      TeamContract[]
  cpLinks        TeamCpLink[]

  @@index([department, name])
}

model TeamContract {
  id             String   @id @default(cuid())
  personId       String
  project        String
  object         String   @db.Text
  contractNumber String?
  documentUrl    String?
  accountCode    String?
  amount         Decimal  @db.Decimal(14, 2)
  startDate      DateTime?
  endDate        DateTime?
  status         String   @default("ATIVO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  person         TeamPerson @relation(fields: [personId], references: [id], onDelete: Restrict)
  stages         TeamStage[]
  cpLinks        TeamCpLink[]

  @@index([personId, project])
}

model TeamStage {
  id          String   @id @default(cuid())
  contractId  String
  label       String
  dueDate     DateTime
  amount      Decimal  @db.Decimal(14, 2)
  cpDocument  String?
  createdAt   DateTime @default(now())
  contract    TeamContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([dueDate])
}

model TeamCpLink {
  id         String   @id @default(cuid())
  sourceKey  String   @unique
  personId   String
  contractId String?
  createdAt  DateTime @default(now())
  person     TeamPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  contract   TeamContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([personId])
}

model BillingTarget {
  id        String   @id @default(cuid())
  month     String
  project   String
  amount    Decimal  @db.Decimal(14, 2)
  createdBy String
  createdAt DateTime @default(now())

  @@unique([month, project])
}

model DirectorProfile {
  id         String   @id @default(cuid())
  name       String
  userId     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cpLinks    DirectorCpLink[]
}

model DirectorCpLink {
  id          String   @id @default(cuid())
  sourceKey   String   @unique
  profileId   String
  category    String
  allocations Json?
  note        String?
  createdAt   DateTime @default(now())
  profile     DirectorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
